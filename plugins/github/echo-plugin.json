{
  "id": "github",
  "name": "GitHub",
  "version": "0.2.1",
  "echo": ">=0.9.2",
  "summary": "Your GitHub in Echo: CI, open pull requests and reviews on Today, GitHub's items in My work and in each thread's Work, with the computer's own GitHub sign-in or one you make in Echo",
  "icon": "icon.svg",
  "uses": {
    "signin": {
      "hosts": [
        "github.com"
      ],
      "keep": true
    },
    "network": {
      "hosts": [
        "api.github.com",
        "github.com"
      ]
    },
    "work": {},
    "sessions": {
      "hints": true
    }
  },
  "main": "main.js",
  "client": "client.js",
  "widgets": [
    {
      "id": "repos",
      "label": "GitHub repos",
      "about": "each repo's CI, open pull requests and reviews for you",
      "kind": "list",
      "sizes": [
        "M",
        "L"
      ],
      "heights": [
        1,
        2
      ],
      "refresh": 60,
      "params": [
        {
          "key": "thread",
          "label": "Thread (its repos)",
          "type": "thread"
        },
        {
          "key": "ci",
          "label": "CI",
          "type": "bool",
          "default": true
        },
        {
          "key": "prs",
          "label": "Open pull requests",
          "type": "bool",
          "default": true
        },
        {
          "key": "reviews",
          "label": "Reviews for you",
          "type": "bool",
          "default": true
        },
        {
          "key": "issues",
          "label": "Open issues",
          "type": "bool",
          "default": false
        }
      ]
    },
    {
      "id": "ci",
      "label": "GitHub CI",
      "about": "passing or failing, across your repos",
      "kind": "status",
      "sizes": [
        "S",
        "M"
      ],
      "refresh": 60,
      "params": [
        {
          "key": "thread",
          "label": "Thread (its repos)",
          "type": "thread"
        }
      ]
    },
    {
      "id": "glance",
      "label": "GitHub at a glance",
      "about": "failing CI, open pull requests, reviews for you",
      "kind": "stats",
      "sizes": [
        "M",
        "L"
      ],
      "refresh": 60,
      "params": [
        {
          "key": "thread",
          "label": "Thread (its repos)",
          "type": "thread"
        },
        {
          "key": "ci",
          "label": "CI failing",
          "type": "bool",
          "default": true
        },
        {
          "key": "prs",
          "label": "Open pull requests",
          "type": "bool",
          "default": true
        },
        {
          "key": "reviews",
          "label": "Reviews for you",
          "type": "bool",
          "default": true
        },
        {
          "key": "issues",
          "label": "Open issues",
          "type": "bool",
          "default": false
        }
      ]
    }
  ]
}
